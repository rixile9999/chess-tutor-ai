# Backend
DATABASE_URL=postgresql+asyncpg://chess:chess@localhost:5432/chess_tutor
STOCKFISH_PATH=/opt/homebrew/bin/stockfish
ANTHROPIC_API_KEY=

# Position chat (튜터에게 질문). Runs Claude Code headless under your subscription login;
# no API key is used. `claude` must be installed and logged in (claude /login).
CHAT_CLAUDE_COMMAND=claude
CHAT_MODEL=opus
CHAT_MCP_URL=http://127.0.0.1:8000/mcp/
CHAT_MAX_TURNS=16
CHAT_TIMEOUT_SECONDS=300
CHAT_MAX_DEPTH=18
